# AI 서버 환경변수 (external_api_spec §6). 실제 .env는 gitignore.
GEMINI_API_KEY=
FAL_KEY=

# === Typecast TTS ===
TYPECAST_API_KEY=
TYPECAST_VOICE_ID=tc_672c5f5ce59fac2a48faeaee
TYPECAST_MODEL=ssfm-v30
# TTS 속도(tempo) 0.5~2.0, 기본 1.0
TTS_SPEED=1.0

# === AI 동영상 (fal Wan 2.5) ===
FAL_VIDEO_MODEL=fal-ai/wan-25-preview/text-to-video
FAL_VIDEO_RESOLUTION=720p
FAL_VIDEO_DURATION=5
