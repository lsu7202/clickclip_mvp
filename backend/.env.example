# 백엔드 환경변수 (backend_spec §7). 실제 .env는 gitignore.
# AI_SERVER_URL / WORKSPACE_DIR / CAPCUT_TEMPLATE_DIR 는 docker-compose에서 주입.
PORT=4000
GIPHY_API_KEY=
SERPAPI_KEY=

# === CapCut export 경로 (컴퓨터마다 1회만 설정) ===
# 본인 CapCut 드래프트 폴더(com.lveditor.draft). export JSON의 모든 절대경로 기준.
#   Mac : /Users/<사용자명>/Movies/CapCut/User Data/Projects/com.lveditor.draft
#   Win : C:/Users/<사용자명>/AppData/Local/CapCut/User Data/Projects/com.lveditor.draft
CAPCUT_DRAFT_ROOT=/Users/CHANGE_ME/Movies/CapCut/User Data/Projects/com.lveditor.draft
# CapCut 시스템 폰트 (자막). Mac 기본값. 바꿀 일 거의 없음.
CAPCUT_FONT_PATH=/Applications/CapCut.app/Contents/Resources/Font/SystemFont/en.ttf
